NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=api-gateway
READINESS_ENABLED=true

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=api-gateway
KAFKA_GROUP_ID=api-gateway.consumer
KAFKA_TOPIC_PREFIX=rkgb
KAFKA_RETRY_ATTEMPTS=5
KAFKA_RETRY_BACKOFF_MS=300

# PostgreSQL / pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rkgb
POSTGRES_USER=rkgb
POSTGRES_PASSWORD=rkgb_dev_password
POSTGRES_SSL=false

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=rkgb_dev_password
NEO4J_DATABASE=neo4j

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=rkgb:

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=rkgb_minio
MINIO_ROOT_PASSWORD=rkgb_minio_password
MINIO_BUCKET=rkgb-documents
MINIO_REGION=us-east-1